---
// Root entry point. Server-side this is a plain meta-refresh to the Arabic
// site (the default language); the inline script upgrades that to a
// language-aware redirect when JavaScript is available.
// Search engines follow the canonical link to /ar/.
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>مدرسة الوفاء اللبناني | Alwafaa Lebanese School</title>
  <meta name="description" content="الموقع الرسمي لمدرسة الوفاء اللبناني. The official website of Alwafaa Lebanese School." />
  <link rel="canonical" href="https://www.alwafaaschool.com/ar/" />
  <link rel="alternate" hreflang="ar" href="https://www.alwafaaschool.com/ar/" />
  <link rel="alternate" hreflang="en" href="https://www.alwafaaschool.com/en/" />
  <link rel="alternate" hreflang="x-default" href="https://www.alwafaaschool.com/ar/" />
  <meta http-equiv="refresh" content="0; url=/ar/" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <script>
    (() => {
      try {
        const stored = localStorage.getItem('alwafaa:lang');
        let target;
        if (stored === 'en' || stored === 'ar') {
          target = stored;
        } else {
          const tags = navigator.languages ?? [navigator.language];
          target = tags.some((l) => String(l).toLowerCase().startsWith('en')) ? 'en' : 'ar';
        }
        window.location.replace('/' + target + '/');
      } catch {
        window.location.replace('/ar/');
      }
    })();
  </script>
</head>
<body>
  <p style="font-family:system-ui;padding:2rem;text-align:center">
    <a href="/ar/">المتابعة إلى الموقع</a> &middot; <a href="/en/">Continue to the site</a>
  </p>
</body>
</html>
