---
// Root entry point. Server-side this is a plain meta-refresh to the Arabic
// site (the default language); the inline script upgrades that to a
// language-aware redirect when JavaScript is available.
// Search engines follow the canonical link to /ar/.
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>مدرسة الوفاء اللبناني | Alwafaa Lebanese School</title>
  <meta name="description" content="الموقع الرسمي لمدرسة الوفاء اللبناني. The official website of Alwafaa Lebanese School." />
  <link rel="canonical" href="https://www.alwafaaschool.com/ar/" />
  <link rel="alternate" hreflang="ar" href="https://www.alwafaaschool.com/ar/" />
  <link rel="alternate" hreflang="en" href="https://www.alwafaaschool.com/en/" />
  <link rel="alternate" hreflang="x-default" href="https://www.alwafaaschool.com/ar/" />
  <meta http-equiv="refresh" content="0; url=/ar/" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <style>
    /* This page is only ever seen for the instant before the redirect
       fires, so it must not flash white. Paint the brand ground straight
       away and keep the manual links out of sight; the script below only
       reveals them if the redirect has not happened after a moment, which
       in practice means JavaScript is off or the redirect was blocked. */
    html{background:#8C1230}
    body{
      margin:0;
      min-height:100vh;
      display:grid;
      place-items:center;
      background:linear-gradient(165deg,#A0183A,#640C21);
      color:#F0DFB2;
      font-family:system-ui,-apple-system,'Segoe UI',sans-serif;
    }
    .fallback{
      opacity:0;
      transition:opacity .2s ease;
      text-align:center;
      padding:2rem;
      margin:0;
      line-height:2;
    }
    .fallback.show{opacity:1}
    .fallback a{color:#F0DFB2;text-underline-offset:3px}
    .fallback a:hover{color:#fff}
    /* Without JavaScript the reveal never runs, so show them outright. */
    @media (scripting:none){.fallback{opacity:1}}
  </style>
  <noscript><style is:global>.fallback{opacity:1 !important}</style></noscript>
  <script>
    (() => {
      try {
        const stored = localStorage.getItem('alwafaa:lang');
        let target;
        if (stored === 'en' || stored === 'ar') {
          target = stored;
        } else {
          const tags = navigator.languages ?? [navigator.language];
          target = tags.some((l) => String(l).toLowerCase().startsWith('en')) ? 'en' : 'ar';
        }
        window.location.replace('/' + target + '/');
      } catch {
        window.location.replace('/ar/');
      }
    })();
  </script>
</head>
<body>
  <p class="fallback">
    <a href="/ar/">المتابعة إلى الموقع</a> &middot; <a href="/en/">Continue to the site</a>
  </p>
  <script>
    // If we are still here after a beat, the redirect did not take - only
    // then is the manual choice worth showing.
    setTimeout(() => document.querySelector('.fallback')?.classList.add('show'), 900);
  </script>
</body>
</html>
