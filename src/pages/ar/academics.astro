---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';

// DRAFT COPY - the school must confirm which cycles it actually offers.
const cycles = [
  {
    title: 'الروضات',
    meta: 'من ٣ إلى ٥ سنوات',
    body: 'ثلاثُ سنواتٍ تمهيديةٌ يتعرّفُ فيها الطفلُ إلى الحروفِ والأرقامِ واللغاتِ من خلالِ اللعبِ والأنشطةِ الحركيةِ والفنية، في بيئةٍ صبورةٍ تراعي أنّ لكلِّ طفلٍ إيقاعَه.',
  },
  {
    title: 'المرحلة الابتدائية',
    meta: 'الصفوف ١ إلى ٦',
    body: 'ترسيخُ القراءةِ والكتابةِ والحسابِ وبناءُ عاداتِ الدرسِ المنتظم، مع تدريسِ اللغاتِ الثلاث: العربيةِ والإنكليزيةِ والفرنسية، إضافةً إلى العلومِ والاجتماعياتِ والتربيةِ الفنيةِ والرياضة.',
  },
  {
    title: 'المرحلة المتوسطة',
    meta: 'الصفوف ٧ إلى ٩',
    body: 'توسيعُ المناهجِ العلميةِ والأدبيةِ وتنميةُ التفكيرِ النقديِّ ومهاراتِ البحث، مع متابعةٍ دقيقةٍ تُهيّئُ الطالبَ لامتحاناتِ الشهادةِ المتوسطة (البريفيه).',
  },
];

const languages = [
  { title: 'العربية', body: 'لغةُ التعليمِ الأساسيةُ ولغةُ الهوية، تُدرَّسُ أدباً ونحواً وتعبيراً في جميعِ المراحل.' },
  { title: 'الإنكليزية', body: 'تُدرَّسُ من الروضةِ وتتدرّجُ حتى تصبحَ لغةَ تدريسٍ للموادِّ العلميةِ في المرحلةِ المتوسطة.' },
  { title: 'الفرنسية', body: 'لغةٌ ثالثةٌ تُدرَّسُ ضمنَ المنهجِ الرسميِّ اللبناني، تفتحُ أمامَ الطالبِ خياراتٍ جامعيةً أوسع.' },
];
---
<BaseLayout
  title="الأقسام التعليمية"
  description="المراحلُ التعليميةُ في مدرسةِ الوفاءِ اللبناني من الروضةِ حتى الصفِّ التاسع، واللغاتُ الثلاثُ المعتمدة."
>
  <PageHeader
    eyebrow="الأقسام التعليمية"
    title="من الروضةِ إلى الصفِّ التاسع"
    lead="نعتمدُ المنهجَ اللبنانيَّ الرسميَّ، ونرافقُ الطالبَ في كلِّ مرحلةٍ بما يناسبُ عمرَه وقدراتِه."
  />

  <Section title="مراحلُنا">
    <CardGrid min="260px">
      {cycles.map((c) => (
        <Card title={c.title} meta={c.meta}><p>{c.body}</p></Card>
      ))}
    </CardGrid>
  </Section>

  <Section eyebrow="اللغات" title="ثلاثُ لغاتٍ منذ البداية" alt>
    <p>
      نُدرّسُ ثلاثَ لغاتٍ لأنّ الطالبَ اللبنانيَّ يحتاجُها في دراستِه الجامعيةِ
      وعملِه لاحقاً، ولأنّ إتقانَ اللغةِ الأمِّ شرطٌ لإتقانِ ما سواها.
    </p>
    <CardGrid min="240px">
      {languages.map((l) => (
        <Card title={l.title}><p>{l.body}</p></Card>
      ))}
    </CardGrid>
  </Section>

  <CtaBand
    title="تسجيلُ الطلابِ الجدد"
    text="للاستفسارِ عن الصفوفِ المتاحةِ وشروطِ التسجيل، تواصلوا مع إدارةِ المدرسة."
    actionLabel="شروطُ التسجيل"
    actionHref="/ar/admissions/"
  />
</BaseLayout>
