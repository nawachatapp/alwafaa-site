---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import Steps from '../../components/Steps.astro';
import Notice from '../../components/Notice.astro';
import CtaBand from '../../components/CtaBand.astro';

// DRAFT COPY - NOTHING ON THIS PAGE IS CONFIRMED.
// Requirements, documents and dates are invented placeholders and MUST be
// replaced with the school's real admissions policy before launch.
const steps = [
  {
    title: 'التواصلُ مع الإدارة',
    body: 'اتصلوا بالمدرسةِ أو زوروها للاستفسارِ عن توفّرِ مقعدٍ في الصفِّ المطلوب.',
    phones: true,
  },
  {
    title: 'زيارةُ المدرسةِ ولقاءُ الإدارة',
    body: 'نرحّبُ بكم لجولةٍ في المدرسةِ وللتعرّفِ إلى المنهجِ والنظامِ الدراسي، وللإجابةِ عن أسئلتِكم.',
  },
  {
    title: 'تقديمُ المستندات',
    body: 'إحضارُ الأوراقِ المطلوبةِ كاملةً إلى قسمِ التسجيلِ في المدرسة.',
  },
  {
    title: 'مقابلةٌ أو امتحانُ تحديدِ مستوى',
    body: 'لبعضِ الصفوفِ يُجرى امتحانٌ قصيرٌ لتحديدِ المستوى، أو مقابلةٌ للطلابِ الصغار.',
  },
  {
    title: 'تثبيتُ التسجيل',
    body: 'بعدَ الموافقةِ يُستكملُ التسجيلُ وتُسلَّمُ الأهلَ لائحةُ القرطاسيةِ والزيِّ المدرسي.',
  },
];

const documents = [
  { title: 'إخراجُ قيدٍ فردي', body: 'حديثُ الإصدار، للطالبِ المُراد تسجيلُه.' },
  { title: 'صورٌ شمسية', body: 'أربعُ صورٍ حديثةٍ بخلفيةٍ بيضاء.' },
  { title: 'الإفادةُ المدرسية', body: 'من المدرسةِ السابقةِ للطلابِ المنتقلين، مع كشفِ العلامات.' },
  { title: 'بطاقةُ التلقيح', body: 'نسخةٌ عن سجلِّ التلقيحِ لطلابِ الروضاتِ والابتدائي.' },
  { title: 'هويةُ وليِّ الأمر', body: 'صورةٌ عن الهويةِ أو جوازِ السفر.' },
];
---
<BaseLayout
  title="التسجيل"
  description="شروطُ التسجيلِ في مدرسةِ الوفاءِ اللبناني، والمستنداتُ المطلوبةُ ومراحلُ التسجيل."
>
  <PageHeader
    eyebrow="التسجيل"
    title="سجّلوا أبناءَكم معنا"
    lead="بابُ التسجيلِ مفتوحٌ لجميعِ المراحلِ من الروضةِ حتى الصفِّ التاسع، ضمنَ المقاعدِ المتاحةِ في كلِّ صف."
  />

  <Section title="مراحلُ التسجيل" narrow>
    <p>خطواتُ التسجيلِ واضحةٌ ولا تستغرقُ وقتاً طويلاً.</p>
    <Steps steps={steps} />
  </Section>

  <Section eyebrow="المستندات" title="الأوراقُ المطلوبة" alt>
    <p>يُرجى إحضارُ المستنداتِ التاليةِ عندَ التسجيل.</p>
    <CardGrid min="240px">
      {documents.map((d) => (
        <Card title={d.title}><p>{d.body}</p></Card>
      ))}
    </CardGrid>
  </Section>

  <Section title="مواعيدُ التسجيل" narrow>
    <p>
      يبدأُ التسجيلُ للعامِ الدراسيِّ الجديدِ عادةً في شهرِ حزيران، ويستمرُّ
      حتى امتلاءِ المقاعدِ المتاحة. ننصحُ الأهلَ بالتواصلِ باكراً، إذ تمتلئُ
      صفوفُ الروضاتِ بسرعةٍ في كلِّ عام.
    </p>
    <p>
      كما نستقبلُ الطلابَ المنتقلينَ خلالَ العامِ الدراسيِّ إذا توفّرَ مقعدٌ
      في الصفِّ المطلوب.
    </p>

    <Notice title="معلوماتٌ بانتظارِ تأكيدِ الإدارة">
      <p>
        المستنداتُ والمواعيدُ والخطواتُ الواردةُ في هذه الصفحةِ هي صياغةٌ
        أوّليةٌ وُضعت لتكونَ نموذجاً، ولم تُعتمَد بعدُ من إدارةِ المدرسة.
      </p>
      <p>
        يُرجى الاتصالُ بالمدرسةِ لتأكيدِ الشروطِ والأقساطِ والمواعيدِ الرسمية
        قبلَ اعتمادِ أيِّ معلومةٍ هنا.
      </p>
    </Notice>
  </Section>

  <CtaBand
    title="لديكم سؤالٌ عن التسجيل؟"
    text="اتصلوا بنا مباشرةً، ويسعدُ قسمُ التسجيلِ بمساعدتِكم والإجابةِ عن كلِّ استفسار."
    actionLabel="معلوماتُ التواصل"
    actionHref="/ar/contact/"
  />
</BaseLayout>
