---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Section from '../../../components/Section.astro';
import { formatDate, isoDate } from '../../../i18n/dates';

// Only Arabic posts, newest first, drafts excluded.
const posts = (await getCollection('news', (e) => e.id.startsWith('ar/') && !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="الأخبار"
  description="آخرُ أخبارِ مدرسةِ الوفاءِ اللبناني وإعلاناتِها وفعالياتِها."
>
  <PageHeader
    eyebrow="الأخبار"
    title="أخبارُ المدرسةِ وإعلاناتُها"
    lead="تابعوا آخرَ المستجدّاتِ والإعلاناتِ الرسميةِ الصادرةِ عن إدارةِ المدرسة."
  />

  <Section narrow>
    {posts.length === 0 ? (
      <p>لا توجدُ أخبارٌ منشورةٌ حالياً.</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li class="post">
            <time class="post__date" datetime={isoDate(post.data.date)}>
              {formatDate(post.data.date, 'ar')}
            </time>
            <h2 class="post__title">
              <a href={`/ar/news/${post.id.replace('ar/', '')}/`}>{post.data.title}</a>
            </h2>
            <p class="post__summary">{post.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </Section>
</BaseLayout>

<style>
  .posts{list-style:none;margin:0;padding:0;display:grid;gap:var(--sp-5)}
  .post{
    margin:0;
    max-width:none;
    padding-bottom:var(--sp-5);
    border-bottom:1px solid var(--line);
  }
  .post:last-child{border-bottom:none;padding-bottom:0}
  .post__date{
    display:block;
    font-size:var(--step--1);
    color:var(--gold-ink);
    font-weight:600;
    margin-bottom:var(--sp-1);
  }
  .post__title{font-size:var(--step-2);margin:0 0 var(--sp-2)}
  .post__title a{color:var(--burgundy);text-decoration:none}
  .post__title a:hover{text-decoration:underline}
  .post__summary{color:var(--ink-soft);margin:0}
</style>
