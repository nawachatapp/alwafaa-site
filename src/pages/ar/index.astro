---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';
import LatestNews from '../../components/LatestNews.astro';

// DRAFT COPY - written as a proposal for the school to review and correct.
const cycles = [
  { title: 'الروضات', meta: 'من ٣ إلى ٥ سنوات', body: 'بيئةٌ آمنةٌ ودافئة يكتشفُ فيها الطفلُ الحروفَ والأرقامَ واللغاتِ من خلالِ اللعبِ والنشاطِ، ويبني ثقتَه بنفسِه وعلاقتَه بالمدرسة.' },
  { title: 'المرحلة الابتدائية', meta: 'الصفوف ١ إلى ٦', body: 'ترسيخُ المهاراتِ الأساسيةِ في القراءةِ والكتابةِ والحساب، مع عنايةٍ خاصةٍ باللغاتِ الثلاث: العربيةِ والإنكليزيةِ والفرنسية.' },
  { title: 'المرحلة المتوسطة', meta: 'الصفوف ٧ إلى ٩', body: 'توسيعُ المعارفِ العلميةِ والأدبيةِ وتنميةُ التفكيرِ النقدي، وتهيئةُ الطالبِ لامتحاناتِ الشهادةِ المتوسطة.' },
];

const values = [
  { title: 'الانتماء', body: 'نربّي في طلابِنا الاعتزازَ بلغتِهم وتاريخِهم وانتماءِهم إلى وطنِهم لبنان.' },
  { title: 'العلم', body: 'نؤمنُ أنّ العلمَ أمانةٌ ومسؤولية، وأنّ المعلّمَ شريكٌ في بناءِ الإنسانِ لا ناقلٌ للمعلومةِ فحسب.' },
  { title: 'الأخلاق', body: 'الصدقُ والاحترامُ والوفاءُ ليست دروساً تُلقّن، بل سلوكٌ يُمارَسُ يوميّاً داخلَ الصفِّ وخارجَه.' },
];
---
<BaseLayout
  title="الرئيسية"
  description="الموقع الرسمي لمدرسة الوفاء اللبناني، تأسست عام ٢٠٠٠. أخبار المدرسة وبرامجها التعليمية وشروط التسجيل."
>
  <Hero />

  <Section eyebrow="أهلاً بكم" title="مدرسةٌ تبني الإنسان" narrow>
    <p>
      منذُ عامِ ٢٠٠٠ ومدرسةُ الوفاءِ اللبناني تفتحُ أبوابَها لأجيالٍ من الطلاب،
      تُعلّمُهم أنّ المعرفةَ لا قيمةَ لها من دونِ خُلُقٍ يحملُها، وأنّ المدرسةَ
      بيتٌ ثانٍ لا مجرّدَ صفوفٍ ومقاعد.
    </p>
    <p>
      نُقدّمُ تعليماً يجمعُ بين رصانةِ المنهجِ اللبنانيِّ الرسميِّ وانفتاحِ
      التعليمِ الحديث، في بيئةٍ يعرفُ فيها كلُّ معلّمٍ طلابَه بأسمائِهم،
      ويجدُ فيها كلُّ أهلٍ باباً مفتوحاً للسؤالِ والمتابعة.
    </p>
  </Section>

  <Section eyebrow="الأقسام" title="مراحلُنا التعليمية" alt>
    <p>نرافقُ الطالبَ من خطواتِه الأولى في الروضةِ حتى الشهادةِ المتوسطة.</p>
    <CardGrid min="250px">
      {cycles.map((c) => (
        <Card title={c.title} meta={c.meta}><p>{c.body}</p></Card>
      ))}
    </CardGrid>
  </Section>

  <Section eyebrow="قيمُنا" title="ما نحرصُ عليه">
    <CardGrid min="260px">
      {values.map((v) => (
        <Card title={v.title}><p>{v.body}</p></Card>
      ))}
    </CardGrid>
  </Section>

  <Section eyebrow="آخرُ الأخبار" title="أخبارُ المدرسةِ وإعلاناتُها" narrow>
    <LatestNews />
  </Section>

  <CtaBand
    title="هل ترغبونَ بتسجيلِ ولدِكم؟"
    text="بابُ التسجيلِ مفتوح. تفضّلوا بزيارةِ المدرسةِ أو اتصلوا بنا، ويسعدُنا أن نجيبَ عن كلِّ أسئلتِكم."
    actionLabel="شروطُ التسجيل"
    actionHref="/ar/admissions/"
  />
</BaseLayout>

