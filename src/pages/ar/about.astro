---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';

// DRAFT COPY - for the school to review and correct.
const crest = [
  { title: 'الجبل', body: 'رمزُ لبنان وثباتِه، وإشارةٌ إلى أنّ العلمَ رفعةٌ وارتقاء.' },
  { title: 'الكتاب', body: 'المعرفةُ المفتوحةُ لكلِّ من طلبَها، وأساسُ كلِّ بناءٍ في هذه المدرسة.' },
  { title: 'القلم', body: 'من قولِه تعالى «عَلَّمَ بالقَلَم»، وهو شعارُ المدرسةِ منذ تأسيسِها.' },
];
---
<BaseLayout
  title="عن المدرسة"
  description="تاريخُ مدرسةِ الوفاءِ اللبناني منذ عام ٢٠٠٠، ورسالتُها وقيمُها ومعنى شعارِها."
>
  <PageHeader
    eyebrow="عن المدرسة"
    title="مدرسةُ الوفاءِ اللبناني"
    lead="خمسٌ وعشرونَ سنةً من التعليم، وأجيالٌ تخرّجت من بينِ جدرانِنا."
  />

  <Section title="نشأتُنا" narrow>
    <p>
      تأسّست مدرسةُ الوفاءِ اللبناني عامَ ٢٠٠٠ بفكرةٍ بسيطةٍ وواضحة: أن يجدَ
      أبناءُ المنطقةِ مدرسةً قريبةً منهم، تُعلّمُهم جيّداً وتُعاملُهم كأبناء،
      من دونِ أن يضطرَّ الأهلُ إلى البحثِ بعيداً عن بيوتِهم.
    </p>
    <p>
      بدأنا بعددٍ متواضعٍ من الصفوفِ والطلاب، ونمَت المدرسةُ سنةً بعد سنةٍ
      بثقةِ الأهالي قبلَ أيِّ شيءٍ آخر. اليومَ نستقبلُ الطلابَ من الروضةِ حتى
      الشهادةِ الثانوية، وما زالت الفكرةُ الأولى هي نفسَها.
    </p>
  </Section>

  <Section title="رسالتُنا" alt narrow>
    <p>
      نسعى إلى تخريجِ طالبٍ متمكّنٍ من علمِه، معتزٍّ بلغتِه وهويّتِه، قادرٍ على
      التفكيرِ المستقلِّ وعلى العملِ مع غيرِه. نريدُه أن يخرجَ من المدرسةِ
      وقد تعلّمَ كيف يتعلّم، لا كيف يحفظُ فحسب.
    </p>
    <p>
      ونؤمنُ أنّ هذا لا يتحقّقُ إلّا بشراكةٍ حقيقيةٍ مع الأهل. بابُ الإدارةِ
      مفتوحٌ دائماً، والمعلّمُ في متناولِ وليِّ الأمرِ لا خلفَ حاجز.
    </p>
  </Section>

  <Section eyebrow="الشعار" title="معنى شعارِنا">
    <p>يحملُ شعارُ المدرسةِ ثلاثةَ عناصرَ، لكلٍّ منها دلالتُه.</p>
    <CardGrid min="240px">
      {crest.map((c) => (
        <Card title={c.title}><p>{c.body}</p></Card>
      ))}
    </CardGrid>
  </Section>

  <CtaBand
    title="زوروا المدرسة"
    text="أفضلُ طريقةٍ للتعرّفِ إلينا أن تروا المدرسةَ بأنفسِكم. نرحّبُ بكم في أيِّ يومِ عمل."
    actionLabel="اتصلوا بنا"
    actionHref="/ar/contact/"
  />
</BaseLayout>
