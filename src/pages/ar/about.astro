---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';

// DRAFT COPY - for the school to review and correct.
const crest = [
  { title: 'الجبل', body: 'رمزُ لبنان وثباتِه، وإشارةٌ إلى أنّ العلمَ رفعةٌ وارتقاء.' },
  { title: 'الكتاب', body: 'المعرفةُ المفتوحةُ لكلِّ من طلبَها، وأساسُ كلِّ بناءٍ في هذه المدرسة.' },
  { title: 'القلم', body: 'من قولِه تعالى «عَلَّمَ بالقَلَم»، وهو شعارُ المدرسة.' },
  { title: 'غصنُ الأرز', body: 'رمزُ لبنانَ الوطني، يثبتُ في كلِّ فصل: القوّةُ والصمودُ اللذانِ نرجوهما لكلِّ طالب.' },
  { title: 'غصنُ الزيتون', body: 'ضاربٌ في أرضِ لبنانَ وتاريخِه، دلالةُ الحكمةِ والصبرِ والنماءِ المتّصل.' },
];
---
<BaseLayout
  title="عن المدرسة"
  description="تاريخُ مدرسةِ الوفاءِ اللبناني منذ عام ٢٠٠٠، ورسالتُها وقيمُها ومعنى شعارِها."
>
  <PageHeader
    eyebrow="عن المدرسة"
    title="مدرسة الوفاء اللبناني"
    lead="خمسٌ وعشرونَ سنةً من التعليم، وأجيالٌ تخرّجت من بينِ جدرانِنا."
  />

  <Section title="نشأتُنا" narrow>
    <p>
      تأسّست مدرسةُ الوفاءِ اللبناني عامَ ٢٠٠٠ بفكرةٍ بسيطةٍ وواضحة: أن يجدَ
      أبناءُ المنطقةِ مدرسةً قريبةً منهم، تُعلّمُهم جيّداً وتُعاملُهم كأبناء،
      من دونِ أن يضطرَّ الأهلُ إلى البحثِ بعيداً عن بيوتِهم.
    </p>
    <p>
      بدأنا بعددٍ متواضعٍ من الصفوفِ والطلاب، ونمَت المدرسةُ سنةً بعد سنةٍ
      بثقةِ الأهالي قبلَ أيِّ شيءٍ آخر. اليومَ نستقبلُ الطلابَ من الروضةِ حتى
      الصفِّ التاسع، وما زالت الفكرةُ الأولى هي نفسَها.
    </p>
  </Section>

  <Section title="رسالتُنا" alt narrow>
    <p>
      نسعى إلى تخريجِ طالبٍ متمكّنٍ من علمِه، معتزٍّ بلغتِه وهويّتِه، قادرٍ على
      التفكيرِ المستقلِّ وعلى العملِ مع غيرِه. نريدُه أن يخرجَ من المدرسةِ
      وقد تعلّمَ كيف يتعلّم، لا كيف يحفظُ فحسب.
    </p>
    <p>
      ونؤمنُ أنّ هذا لا يتحقّقُ إلّا بشراكةٍ حقيقيةٍ مع الأهل. بابُ الإدارةِ
      مفتوحٌ دائماً، والمعلّمُ في متناولِ وليِّ الأمرِ لا خلفَ حاجز.
    </p>
  </Section>

  <Section eyebrow="الشعار" title="معنى شعارِنا">
    <div class="crest-intro">
      <img
        class="crest-intro__img"
        src="/logo.png"
        alt="شعارُ المدرسة: جبلٌ فوقَ كتابٍ مفتوحٍ ومعه قلم، يحيطُ بهما غصنُ أرزٍ وغصنُ زيتون."
        width="200"
        height="200"
      />
      <p class="crest-intro__text">يحملُ شعارُ المدرسةِ خمسةَ عناصرَ، لكلٍّ منها دلالتُه.</p>
    </div>
    {/* 300px, not the 240px default: five cards at 240 fit 4-up on a wide
        screen and orphan the fifth on its own row. 300 gives a 3+2 split. */}
    <CardGrid min="300px">
      {crest.map((c) => (
        <Card title={c.title}><p>{c.body}</p></Card>
      ))}
    </CardGrid>
  </Section>

  <CtaBand
    title="زوروا المدرسة"
    text="أفضلُ طريقةٍ للتعرّفِ إلينا أن تروا المدرسةَ بأنفسِكم. نرحّبُ بكم في أيِّ يومِ عمل."
    actionLabel="اتصلوا بنا"
    actionHref="/ar/contact/"
  />
</BaseLayout>

<style>
  /* The crest shown beside its own explanation, so a reader can look from
     the words to the thing being described without scrolling back up. */
  .crest-intro{
    display:flex;
    align-items:center;
    gap:var(--sp-5);
    margin-block:var(--sp-4) var(--sp-5);
  }
  .crest-intro__img{
    inline-size:clamp(104px,15vw,150px);
    block-size:clamp(104px,15vw,150px);
    flex:none;
    border-radius:50%;
    object-fit:cover;
    background:var(--surface);
    border:2px solid rgba(200,162,74,.5);
    box-shadow:0 10px 28px -14px rgba(74,9,24,.5);
  }
  .crest-intro__text{margin:0}

  @media (max-width:560px){
    .crest-intro{flex-direction:column;text-align:center;gap:var(--sp-3)}
  }
</style>
