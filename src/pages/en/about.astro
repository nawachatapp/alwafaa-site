---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';

// DRAFT COPY - for the school to review and correct.
const crest = [
  { title: 'The mountain', body: 'A symbol of Lebanon and of steadfastness, and a reminder that learning is a climb upward.' },
  { title: 'The book', body: 'Knowledge, open to everyone who seeks it, and the foundation of everything this school builds.' },
  { title: 'The pen', body: 'From the verse "He who taught by the pen" - the school\'s motto.' },
  { title: 'The cedar', body: 'Lebanon’s own emblem, standing through every season - the strength and resilience we hope each student carries.' },
  { title: 'The olive', body: 'Rooted deep in the land and its history, a sign of wisdom, of patience, and of steady growth.' },
];
---
<BaseLayout
  title="About the School"
  description="The history of Alwafaa Lebanese School since 2000, its mission, its values, and the meaning of its crest."
>
  <PageHeader
    eyebrow="About"
    title="Alwafaa Lebanese School"
    lead="Twenty-five years of teaching, and generations who have grown up within these walls."
  />

  <Section title="How we began" narrow>
    <p>
      Alwafaa Lebanese School was founded in 2000 on a simple, clear idea: that
      the children of this area should have a good school close to home - one
      that would teach them well and treat them as its own, so that no parent
      would have to look far afield.
    </p>
    <p>
      We opened with a modest number of classes and students, and the school
      grew year by year, on the strength of parents' trust more than anything
      else. Today we welcome students from kindergarten through to
      Grade 9, and that first idea has not changed.
    </p>
  </Section>

  <Section title="Our mission" alt narrow>
    <p>
      We work to send out students who are secure in their learning, proud of
      their language and identity, able to think independently and to work
      alongside others. We want them to leave having learned how to learn -
      not merely how to memorise.
    </p>
    <p>
      None of this happens without a genuine partnership with parents. The
      administration's door stays open, and teachers are within reach of
      families rather than behind a barrier.
    </p>
  </Section>

  <Section eyebrow="The crest" title="What our crest means">
    <div class="crest-intro">
      <img
        class="crest-intro__img"
        src="/logo.png"
        alt="The school crest: a mountain above an open book with a pen, framed by a cedar branch and an olive branch."
        width="200"
        height="200"
      />
      <p class="crest-intro__text">The school's crest carries five elements, each with its own meaning.</p>
    </div>
    {/* 300px, not the 240px default: five cards at 240 fit 4-up on a wide
        screen and orphan the fifth on its own row. 300 gives a 3+2 split. */}
    <CardGrid min="300px">
      {crest.map((c) => (
        <Card title={c.title}><p>{c.body}</p></Card>
      ))}
    </CardGrid>
  </Section>

  <CtaBand
    title="Come and visit"
    text="The best way to know us is to see the school for yourself. You are welcome on any working day."
    actionLabel="Contact us"
    actionHref="/en/contact/"
  />
</BaseLayout>

<style>
  /* The crest shown beside its own explanation, so a reader can look from
     the words to the thing being described without scrolling back up. */
  .crest-intro{
    display:flex;
    align-items:center;
    gap:var(--sp-5);
    margin-block:var(--sp-4) var(--sp-5);
  }
  .crest-intro__img{
    inline-size:clamp(104px,15vw,150px);
    block-size:clamp(104px,15vw,150px);
    flex:none;
    border-radius:50%;
    object-fit:cover;
    background:var(--surface);
    border:2px solid rgba(200,162,74,.5);
    box-shadow:0 10px 28px -14px rgba(74,9,24,.5);
  }
  .crest-intro__text{margin:0}

  @media (max-width:560px){
    .crest-intro{flex-direction:column;text-align:center;gap:var(--sp-3)}
  }
</style>
