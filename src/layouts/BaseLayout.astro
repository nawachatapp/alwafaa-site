---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, alternatePath } from '../i18n/utils';
import { dir } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set on the homepage only, so the hero can sit under the header. */
  bodyClass?: string;
}

const { title, description, bodyClass } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alt = alternatePath(Astro.url, lang);

const canonical = new URL(Astro.url.pathname, Astro.site);
const altHref = new URL(alt.path, Astro.site);
const ogImage = new URL('/logo.png', Astro.site);

// Full title, with the school name appended unless it already leads.
const fullTitle = `${title} | ${t('site.name')}`;
---
<!doctype html>
<html lang={lang} dir={dir[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#8C1230" />
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href={canonical.href} />
  <link rel="alternate" hreflang={alt.lang} href={altHref.href} />
  <link rel="alternate" hreflang={lang} href={canonical.href} />

  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="icon" href="/favicon.png" sizes="64x64" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage.href} />
  <meta property="og:locale" content={lang === 'ar' ? 'ar_LB' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Amiri:wght@400;700&family=Cairo:wght@300;400;600;700&display=swap"
  />
</head>

<body class={bodyClass}>
  <a class="skip-link" href="#main">{t('nav.skip')}</a>
  <Header />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />

  <script>
    // First-visit language detection.
    // Only ever redirects from the site root, and only once: after the reader
    // has chosen a language (or been sent somewhere), the stored preference
    // wins and we never bounce them again. Deep links are never redirected -
    // a link shared in English must stay English.
    (() => {
      try {
        const KEY = 'alwafaa:lang';
        const path = window.location.pathname;
        const atRoot = path === '/' || path === '';
        if (!atRoot) return;

        const stored = localStorage.getItem(KEY);

        let target;
        if (stored === 'en' || stored === 'ar') {
          // A previous choice always wins over the browser setting.
          target = stored;
        } else {
          const tags = navigator.languages ?? [navigator.language];
          const wantsEnglish = tags.some((l) =>
            String(l).toLowerCase().startsWith('en')
          );
          target = wantsEnglish ? 'en' : 'ar';
        }

        window.location.replace('/' + target + '/');
      } catch {
        window.location.replace('/ar/');
      }
    })();

    // Remember whichever language the reader is actually reading, so the
    // switcher's choice sticks on their next visit.
    try {
      const lang = document.documentElement.lang;
      if (lang === 'ar' || lang === 'en') {
        localStorage.setItem('alwafaa:lang', lang);
      }
    } catch { /* private mode - preference simply won't persist */ }
  </script>
</body>
</html>
