---
import { phones } from '../i18n/contact';

interface Props {
  title: string;
  text: string;
  actionLabel: string;
  actionHref: string;
  /** Show the school's phone numbers as secondary buttons. */
  showPhones?: boolean;
}
const { title, text, actionLabel, actionHref, showPhones = true } = Astro.props;
---
<section class="cta-band on-dark">
  <div class="wrap wrap--narrow cta-band__inner">
    <h2 class="cta-band__title">{title}</h2>
    <p class="cta-band__text">{text}</p>
    <div class="cta-band__actions">
      <a class="btn" href={actionHref}>{actionLabel}</a>
      {showPhones && phones.map((p) => (
        <a class="btn btn--ghost" href={`tel:${p.tel}`} dir="ltr">{p.label}</a>
      ))}
    </div>
  </div>
</section>

<style>
  .cta-band{
    background:linear-gradient(160deg,var(--burgundy),var(--burgundy-dark));
    color:var(--cream);
    padding-block:var(--sp-6);
    text-align:center;
  }
  .cta-band__inner{display:grid;justify-items:center}
  .cta-band__title{color:var(--gold-pale);margin:0 0 var(--sp-3)}
  .cta-band__text{color:rgba(247,241,227,.82);margin:0 0 var(--sp-4)}
  .cta-band__actions{display:flex;flex-wrap:wrap;gap:var(--sp-3);justify-content:center}
</style>
