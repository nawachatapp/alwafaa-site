---
import { getLangFromUrl, useTranslations, localisedPath, alternatePath } from '../i18n/utils';
import { headerNav } from '../i18n/ui';
import { portalUrl } from '../i18n/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alt = alternatePath(Astro.url, lang);

// Trailing-slash-insensitive compare, so /en/about and /en/about/ both match.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => localisedPath(path, lang).replace(/\/+$/, '') === here;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={localisedPath('', lang)}>
      <img class="brand__mark" src="/logo.png" alt="" width="94" height="94" />
      <span class="brand__text">
        <span class="brand__name">{t('site.name')}</span>
        <span class="brand__est">{t('site.est')}</span>
      </span>
    </a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="burger__box" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="visually-hidden">{t('nav.menu')}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={t('nav.menu')}>
      <ul class="nav__list">
        {headerNav.map((item) => (
          'children' in item ? (
            <li class="has-menu">
              <button
                type="button"
                class="nav__top"
                aria-expanded="false"
                aria-haspopup="true"
                data-current={item.children.some((c) => isCurrent(c.path)) ? 'true' : undefined}
              >
                {t(item.key)}
                <svg class="nav__caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <ul class="submenu">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={localisedPath(child.path, lang)}
                      aria-current={isCurrent(child.path) ? 'page' : undefined}
                    >{t(child.key)}</a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={localisedPath(item.path, lang)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >{t(item.key)}</a>
            </li>
          )
        ))}
      </ul>
      {/* Icon-only round buttons. The label each one drops is carried by
          aria-label (for screen readers) and by data-tip, which draws the
          visible tooltip - so nothing is lost by hiding the text. */}
      <div class="tools">
        {/* The pupils' web portal, at the school's own address. */}
        <a
          class="tool"
          href={portalUrl}
          target="_blank"
          rel="noopener"
          aria-label={t('cta.portal')}
          data-tip={t('cta.portal')}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3 2.5 8 12 13l9.5-5z" />
            <path d="M6 10.5v4.7c0 .6.3 1.1.8 1.4 1.3.8 3.1 1.4 5.2 1.4s3.9-.6 5.2-1.4c.5-.3.8-.8.8-1.4v-4.7" />
          </svg>
        </a>

        <a
          class="tool"
          href={alt.path}
          lang={alt.lang}
          aria-label={t('lang.label')}
          data-tip={t('lang.switch')}
        >
          {/* The glyph names the language this button switches TO, so an
              English page shows ع and an Arabic page shows ENG. */}
          <span class="tool__glyph" aria-hidden="true">{t('lang.glyph')}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header{
    position:sticky;
    top:0;
    z-index:50;
    background:linear-gradient(180deg,var(--burgundy),var(--burgundy-deep));
    border-bottom:1px solid rgba(200,162,74,.3);
    box-shadow:0 4px 20px -10px rgba(0,0,0,.5);
  }
  .site-header::after{
    content:"";
    position:absolute;
    inset-inline:0;
    bottom:0;
    height:2px;
    background:linear-gradient(90deg,transparent,var(--gold),var(--gold-light),var(--gold),transparent);
    opacity:.7;
  }

  .bar{
    display:flex;
    align-items:center;
    gap:var(--sp-3);
    min-height:var(--header-h);
  }

  /* ---- Brand ---- */
  .brand{
    display:flex;
    align-items:center;
    gap:var(--sp-3);
    text-decoration:none;
    flex:none;
    min-width:0;
  }
  .brand__mark{
    inline-size:clamp(70px,10vw,94px);
    block-size:clamp(70px,10vw,94px);
    border-radius:50%;
    object-fit:cover;
    background:var(--cream);
    border:1.5px solid rgba(200,162,74,.55);
    flex:none;
  }
  .brand__text{display:flex;flex-direction:column;min-width:0}
  .brand__name{
    font-family:var(--font-arabic);
    font-size:clamp(16px,2.4vw,22px);
    font-weight:700;
    color:var(--gold-pale);
    line-height:1.3;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  :root[lang="en"] .brand__name{
    font-family:var(--font-display);
    font-variation-settings:'opsz' 40,'SOFT' 20;
    letter-spacing:0;
    font-weight:600;
  }
  .brand__est{
    font-size:10px;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:rgba(247,241,227,.62);
    white-space:nowrap;
  }
  :root[lang="ar"] .brand__est{letter-spacing:.02em;font-size:11px}

  /* ---- Nav ---- */
  .nav{
    margin-inline-start:auto;
    display:flex;
    align-items:center;
    gap:var(--sp-4);
  }
  .nav__list{
    display:flex;
    align-items:center;
    gap:clamp(10px,1.6vw,22px);
    list-style:none;
    margin:0;
    padding:0;
  }
  .nav__list li{margin:0}
  .nav__list a{
    color:rgba(247,241,227,.86);
    text-decoration:none;
    font-size:14px;
    font-weight:400;
    white-space:nowrap;
    padding-block:6px;
    border-bottom:2px solid transparent;
    transition:color var(--dur) var(--ease),border-color var(--dur) var(--ease);
  }
  .nav__list a:hover{color:var(--gold-pale);border-bottom-color:rgba(200,162,74,.5)}
  .nav__list a[aria-current="page"]{color:var(--gold-light);border-bottom-color:var(--gold)}

  /* ---- Media dropdown ----
     Translucent so the burgundy bar reads through it - the panel belongs to
     the header rather than floating over the page as an opaque slab. */
  .has-menu{position:relative}
  .nav__top{
    display:inline-flex;
    align-items:center;
    gap:6px;
    background:none;
    border:0;
    padding:6px 0;
    margin:0;
    font:inherit;
    font-size:14px;
    color:rgba(247,241,227,.86);
    cursor:pointer;
    border-bottom:2px solid transparent;
    transition:color var(--dur) var(--ease),border-color var(--dur) var(--ease);
  }
  .nav__top:hover{color:var(--gold-pale);border-bottom-color:rgba(200,162,74,.5)}
  .nav__top[data-current]{color:var(--gold-light);border-bottom-color:var(--gold)}
  .nav__caret{
    inline-size:9px;
    block-size:9px;
    transition:transform var(--dur) var(--ease);
  }
  .nav__top[aria-expanded="true"] .nav__caret{transform:rotate(180deg)}

  .submenu{
    position:absolute;
    top:calc(100% + 10px);
    /* Anchored to the trigger's TRAILING edge so the panel grows back under
       the nav, away from the viewport boundary. Media sits near the end of the
       bar, so a leading-edge or centred panel runs outward - past Contact in
       LTR, past the screen edge in RTL - where body{overflow-x:hidden} clips
       it once the bar gets compact. */
    inset-inline-end:0;
    transform:translateY(-4px);
    min-inline-size:max(100%,150px);
    margin:0;
    padding:6px;
    list-style:none;
    display:grid;
    gap:2px;
    border-radius:calc(var(--radius) * 2);
    border:1px solid rgba(200,162,74,.32);
    background:rgba(100,12,33,.72);
    -webkit-backdrop-filter:blur(14px) saturate(140%);
    backdrop-filter:blur(14px) saturate(140%);
    box-shadow:0 16px 34px -16px rgba(0,0,0,.7);
    opacity:0;
    visibility:hidden;
    transition:opacity var(--dur) var(--ease),
               transform var(--dur) var(--ease),
               visibility var(--dur);
  }
  .has-menu:hover .submenu,
  .has-menu:focus-within .submenu,
  .nav__top[aria-expanded="true"] + .submenu{
    opacity:1;
    visibility:visible;
    transform:translateY(0);
  }
  .submenu li{margin:0}
  .submenu a{
    display:block;
    padding:8px 14px;
    border-radius:var(--radius);
    border-bottom:0;
    white-space:nowrap;
  }
  .submenu a:hover{background:rgba(200,162,74,.16);border-bottom:0}
  .submenu a[aria-current="page"]{
    color:var(--gold-light);
    background:rgba(200,162,74,.12);
    border-bottom:0;
  }

  /* ---- Icon tools ----
     The portal and the language switch are the two actions in a bar of
     links, so they read as round glass buttons rather than more text. The
     label they drop lives in aria-label and in the tooltip below. */
  .tools{
    flex:none;
    display:flex;
    align-items:center;
    gap:var(--sp-2);
  }
  .tool{
    position:relative;
    display:grid;
    place-items:center;
    inline-size:38px;
    block-size:38px;
    border-radius:50%;
    /* No gold outline: the glass alone carries it, as in the footer. */
    border:1px solid transparent;
    background:rgba(247,241,227,.12);
    -webkit-backdrop-filter:blur(10px) saturate(140%);
    backdrop-filter:blur(10px) saturate(140%);
    color:var(--gold-pale);
    text-decoration:none;
    transition:background var(--dur) var(--ease),
               border-color var(--dur) var(--ease);
  }
  .tool svg{inline-size:18px;block-size:18px}
  /* The Latin glyph is an abbreviation, so it is set small and tracked out;
     the Arabic letter is a single glyph and carries at a larger size. */
  .tool__glyph{
    font-size:11px;
    font-weight:700;
    letter-spacing:.06em;
    line-height:1;
  }
  :root[lang="en"] .tool__glyph{
    font-family:var(--font-arabic);
    font-size:17px;
    letter-spacing:0;
  }
  .tool:hover,
  .tool:focus-visible{
    background:rgba(247,241,227,.2);
    text-decoration:none;
  }

  /* Tooltip. Pure CSS, driven by data-tip, shown on hover and on keyboard
     focus. aria-label carries the same text, so a screen reader is not told
     twice and never depends on this. */
  .tool::after{
    content:attr(data-tip);
    position:absolute;
    top:calc(100% + 8px);
    inset-inline-end:0;
    padding:5px 10px;
    border-radius:var(--radius);
    border:1px solid rgba(200,162,74,.3);
    background:rgba(74,9,24,.92);
    -webkit-backdrop-filter:blur(8px);
    backdrop-filter:blur(8px);
    color:var(--gold-pale);
    font-size:12px;
    font-weight:400;
    line-height:1.3;
    white-space:nowrap;
    opacity:0;
    visibility:hidden;
    transform:translateY(-3px);
    transition:opacity var(--dur) var(--ease),
               transform var(--dur) var(--ease),
               visibility var(--dur);
    pointer-events:none;
  }
  .tool:hover::after,
  .tool:focus-visible::after{
    opacity:1;
    visibility:visible;
    transform:translateY(0);
  }

  /* ---- Burger ---- */
  .burger{
    display:none;
    margin-inline-start:auto;
    background:none;
    border:1px solid rgba(200,162,74,.4);
    border-radius:var(--radius);
    padding:9px 11px;
    cursor:pointer;
  }
  .burger__box{display:block;inline-size:20px}
  .burger__box i{
    display:block;
    block-size:2px;
    background:var(--gold-pale);
    border-radius:1px;
    transition:transform var(--dur) var(--ease),opacity var(--dur) var(--ease);
  }
  .burger__box i + i{margin-top:4px}
  .burger[aria-expanded="true"] i:nth-child(1){transform:translateY(6px) rotate(45deg)}
  .burger[aria-expanded="true"] i:nth-child(2){opacity:0}
  .burger[aria-expanded="true"] i:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

  /* ---- Mobile ---- */
  @media (max-width:900px){
    .burger{display:block}
    .nav{
      position:absolute;
      inset-inline:0;
      top:100%;
      flex-direction:column;
      align-items:stretch;
      gap:0;
      margin:0;
      padding:var(--sp-3) clamp(16px,4vw,36px) var(--sp-4);
      background:var(--burgundy-dark);
      border-bottom:1px solid rgba(200,162,74,.3);
      display:none;
    }
    .nav.is-open{display:flex}
    .nav__list{flex-direction:column;align-items:stretch;gap:0}
    /* On mobile the panel is pointless - show both links inline instead. */
    .has-menu{position:static}
    .nav__top{display:none}
    .submenu{
      position:static;
      transform:none;
      opacity:1;
      visibility:visible;
      display:block;
      min-inline-size:0;
      padding:0;
      border:0;
      background:none;
      backdrop-filter:none;
      -webkit-backdrop-filter:none;
      box-shadow:none;
    }
    :root[dir="rtl"] .submenu{transform:none}
    .submenu a{padding:12px 0;border-radius:0}
    .submenu a:hover{background:none}
    .nav__list a{
      display:block;
      padding:12px 0;
      border-bottom:1px solid rgba(200,162,74,.14);
      font-size:15px;
    }
    .nav__list a[aria-current="page"]{border-bottom-color:var(--gold)}
    /* In the drawer there is room for words, and a tooltip cannot be
       hovered on a touch screen - so the buttons become labelled rows and
       the tooltip text is printed inline instead. */
    .tools{
      flex-direction:column;
      align-items:stretch;
      gap:var(--sp-2);
      margin-top:var(--sp-3);
    }
    .tool{
      inline-size:auto;
      block-size:auto;
      border-radius:999px;
      grid-auto-flow:column;
      justify-content:center;
      gap:8px;
      padding:11px 16px;
      font-size:14px;
      font-weight:600;
    }
    .tool::after{
      content:attr(data-tip);
      position:static;
      padding:0;
      border:0;
      background:none;
      -webkit-backdrop-filter:none;
      backdrop-filter:none;
      opacity:1;
      visibility:visible;
      transform:none;
      font-size:14px;
      font-weight:600;
      color:inherit;
    }
  }
</style>

<script>
  // Mobile menu. Kept deliberately small - no framework, no dependency.
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('site-nav');

  if (burger && nav) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
    });

    // Escape closes the menu and returns focus to the button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        burger.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
        burger.focus();
      }
    });
  }

  // Dropdown. CSS handles hover; this covers click, touch and the keyboard,
  // where :hover never fires.
  const toggle = document.querySelector<HTMLButtonElement>('.nav__top');

  if (toggle) {
    const close = () => toggle.setAttribute('aria-expanded', 'false');

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
    });

    // A click anywhere else dismisses it.
    document.addEventListener('click', (e) => {
      if (!toggle.parentElement?.contains(e.target as Node)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });

    // Leaving the group by keyboard closes it too.
    toggle.parentElement?.addEventListener('focusout', (e) => {
      if (!toggle.parentElement?.contains(e.relatedTarget as Node)) close();
    });
  }
</script>
