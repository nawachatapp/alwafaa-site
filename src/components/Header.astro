---
import { getLangFromUrl, useTranslations, localisedPath, alternatePath } from '../i18n/utils';
import { navItems } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alt = alternatePath(Astro.url, lang);

// Trailing-slash-insensitive compare, so /en/about and /en/about/ both match.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => localisedPath(path, lang).replace(/\/+$/, '') === here;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={localisedPath('', lang)}>
      <img class="brand__mark" src="/logo.png" alt="" width="64" height="64" />
      <span class="brand__text">
        <span class="brand__name">{t('site.name')}</span>
        <span class="brand__est">{t('site.est')}</span>
      </span>
    </a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="burger__box" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="visually-hidden">{t('nav.menu')}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={t('nav.menu')}>
      <ul class="nav__list">
        {navItems.map((item) => (
          <li>
            <a
              href={localisedPath(item.path, lang)}
              aria-current={isCurrent(item.path) ? 'page' : undefined}
            >{t(item.key)}</a>
          </li>
        ))}
      </ul>
      <a class="lang" href={alt.path} lang={alt.lang} aria-label={t('lang.label')}>
        {t('lang.switch')}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header{
    position:sticky;
    top:0;
    z-index:50;
    background:linear-gradient(180deg,var(--burgundy-deep),var(--burgundy-dark));
    border-bottom:1px solid rgba(200,162,74,.3);
    box-shadow:0 4px 20px -10px rgba(0,0,0,.5);
  }
  .site-header::after{
    content:"";
    position:absolute;
    inset-inline:0;
    bottom:0;
    height:2px;
    background:linear-gradient(90deg,transparent,var(--gold),var(--gold-light),var(--gold),transparent);
    opacity:.7;
  }

  .bar{
    display:flex;
    align-items:center;
    gap:var(--sp-3);
    min-height:var(--header-h);
  }

  /* ---- Brand ---- */
  .brand{
    display:flex;
    align-items:center;
    gap:var(--sp-3);
    text-decoration:none;
    flex:none;
    min-width:0;
  }
  .brand__mark{
    inline-size:clamp(46px,7vw,60px);
    block-size:clamp(46px,7vw,60px);
    border-radius:50%;
    object-fit:cover;
    background:var(--cream);
    border:1.5px solid rgba(200,162,74,.55);
    flex:none;
  }
  .brand__text{display:flex;flex-direction:column;min-width:0}
  .brand__name{
    font-family:var(--font-arabic);
    font-size:clamp(16px,2.4vw,22px);
    font-weight:700;
    color:var(--gold-pale);
    line-height:1.3;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  :root[lang="en"] .brand__name{
    font-family:var(--font-display);
    font-variation-settings:'opsz' 40,'SOFT' 20;
    letter-spacing:0;
    font-weight:600;
  }
  .brand__est{
    font-size:10px;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:rgba(247,241,227,.62);
    white-space:nowrap;
  }
  :root[lang="ar"] .brand__est{letter-spacing:.02em;font-size:11px}

  /* ---- Nav ---- */
  .nav{
    margin-inline-start:auto;
    display:flex;
    align-items:center;
    gap:var(--sp-4);
  }
  .nav__list{
    display:flex;
    align-items:center;
    gap:clamp(10px,1.6vw,22px);
    list-style:none;
    margin:0;
    padding:0;
  }
  .nav__list li{margin:0}
  .nav__list a{
    color:rgba(247,241,227,.86);
    text-decoration:none;
    font-size:14px;
    font-weight:400;
    white-space:nowrap;
    padding-block:6px;
    border-bottom:2px solid transparent;
    transition:color var(--dur) var(--ease),border-color var(--dur) var(--ease);
  }
  .nav__list a:hover{color:var(--gold-pale);border-bottom-color:rgba(200,162,74,.5)}
  .nav__list a[aria-current="page"]{color:var(--gold-light);border-bottom-color:var(--gold)}

  .lang{
    flex:none;
    padding:6px 14px;
    border:1px solid rgba(200,162,74,.45);
    border-radius:var(--radius);
    color:var(--gold-pale);
    text-decoration:none;
    font-size:13px;
    white-space:nowrap;
    transition:background var(--dur) var(--ease),color var(--dur) var(--ease);
  }
  .lang:hover{background:var(--gold);color:var(--burgundy-dark);border-color:var(--gold)}

  /* ---- Burger ---- */
  .burger{
    display:none;
    margin-inline-start:auto;
    background:none;
    border:1px solid rgba(200,162,74,.4);
    border-radius:var(--radius);
    padding:9px 11px;
    cursor:pointer;
  }
  .burger__box{display:block;inline-size:20px}
  .burger__box i{
    display:block;
    block-size:2px;
    background:var(--gold-pale);
    border-radius:1px;
    transition:transform var(--dur) var(--ease),opacity var(--dur) var(--ease);
  }
  .burger__box i + i{margin-top:4px}
  .burger[aria-expanded="true"] i:nth-child(1){transform:translateY(6px) rotate(45deg)}
  .burger[aria-expanded="true"] i:nth-child(2){opacity:0}
  .burger[aria-expanded="true"] i:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

  /* ---- Mobile ---- */
  @media (max-width:900px){
    .burger{display:block}
    .nav{
      position:absolute;
      inset-inline:0;
      top:100%;
      flex-direction:column;
      align-items:stretch;
      gap:0;
      margin:0;
      padding:var(--sp-3) clamp(16px,4vw,36px) var(--sp-4);
      background:var(--burgundy-dark);
      border-bottom:1px solid rgba(200,162,74,.3);
      display:none;
    }
    .nav.is-open{display:flex}
    .nav__list{flex-direction:column;align-items:stretch;gap:0}
    .nav__list a{
      display:block;
      padding:12px 0;
      border-bottom:1px solid rgba(200,162,74,.14);
      font-size:15px;
    }
    .nav__list a[aria-current="page"]{border-bottom-color:var(--gold)}
    .lang{margin-top:var(--sp-3);text-align:center}
  }
</style>

<script>
  // Mobile menu. Kept deliberately small - no framework, no dependency.
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('site-nav');

  if (burger && nav) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
    });

    // Escape closes the menu and returns focus to the button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        burger.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
        burger.focus();
      }
    });
  }
</script>
