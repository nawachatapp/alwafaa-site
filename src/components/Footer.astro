---
import { getLangFromUrl, useTranslations, localisedPath } from '../i18n/utils';
import { navItems } from '../i18n/ui';
import { phones, email, address } from '../i18n/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap foot">

    <div class="foot__brand">
      <img src="/logo.png" alt="" width="72" height="72" class="foot__mark" />
      <p class="foot__name">{t('site.name')}</p>
      <p class="foot__motto">{t('site.tagline')}</p>
      <p class="foot__est">{t('site.est')}</p>
    </div>

    <nav class="foot__col" aria-label={t('footer.quickLinks')}>
      <h2 class="foot__h">{t('footer.quickLinks')}</h2>
      <ul>
        {navItems.map((item) => (
          <li><a href={localisedPath(item.path, lang)}>{t(item.key)}</a></li>
        ))}
      </ul>
    </nav>

    <div class="foot__col">
      <h2 class="foot__h">{t('footer.contact')}</h2>
      <ul>
        {phones.map((p) => (
          <li>
            {/* dir="ltr" keeps the digits in dialling order inside RTL text */}
            <a href={`tel:${p.tel}`} dir="ltr">{p.label}</a>
          </li>
        ))}
        <li><a href={`mailto:${email}`}>{email}</a></li>
        <li>{address[lang]}</li>
      </ul>
    </div>

  </div>

  <div class="wrap foot__base">
    <p>&copy; {year} {t('site.name')} &mdash; {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer{
    margin-top:auto;
    background:linear-gradient(180deg,var(--burgundy-deep),var(--burgundy-dark));
    color:rgba(247,241,227,.78);
    padding-top:var(--sp-6);
    border-top:2px solid var(--gold);
  }

  .foot{
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr;
    gap:var(--sp-5);
    padding-bottom:var(--sp-5);
  }
  @media (max-width:760px){
    .foot{grid-template-columns:1fr;gap:var(--sp-4);text-align:center}
    .foot__brand{justify-items:center}
  }

  .foot__brand{display:grid;gap:var(--sp-1);align-content:start}
  .foot__mark{
    inline-size:66px;block-size:66px;
    border-radius:50%;
    object-fit:cover;
    background:var(--cream);
    border:1.5px solid rgba(200,162,74,.5);
    margin-bottom:var(--sp-2);
  }
  @media (max-width:760px){.foot__mark{margin-inline:auto}}

  .foot__name{
    font-family:var(--font-arabic);
    font-size:var(--step-1);
    font-weight:700;
    color:var(--gold-pale);
    margin:0;
    line-height:1.4;
  }
  :root[lang="en"] .foot__name{font-family:var(--font-display)}

  .foot__motto{
    font-family:var(--font-arabic);
    color:var(--gold-light);
    margin:0;
    font-size:var(--step-0);
  }
  .foot__est{
    font-size:11px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:rgba(247,241,227,.5);
    margin:var(--sp-1) 0 0;
  }

  .foot__h{
    font-family:var(--font-body);
    font-size:11px;
    font-weight:700;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--gold);
    margin:0 0 var(--sp-3);
  }
  :root[lang="ar"] .foot__h{letter-spacing:.04em;font-size:13px}

  .foot__col ul{list-style:none;margin:0;padding:0;display:grid;gap:var(--sp-2)}
  .foot__col li{margin:0;max-width:none}
  .foot__col a{
    color:rgba(247,241,227,.78);
    text-decoration:none;
    font-size:14px;
    transition:color var(--dur) var(--ease);
  }
  .foot__col a:hover{color:var(--gold-pale);text-decoration:underline}

  .foot__base{
    border-top:1px solid rgba(200,162,74,.18);
    padding-block:var(--sp-3);
    text-align:center;
  }
  .foot__base p{
    margin:0;
    max-width:none;
    font-size:12px;
    color:rgba(247,241,227,.45);
    letter-spacing:.04em;
  }
</style>
