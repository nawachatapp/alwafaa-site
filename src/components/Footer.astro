---
import { getLangFromUrl, useTranslations, localisedPath } from '../i18n/utils';
import { navItems } from '../i18n/ui';
import { phones, email, address } from '../i18n/contact';
import { portalUrl } from '../i18n/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap foot">

    <nav class="foot__col" aria-label={t('footer.quickLinks')}>
      <h2 class="foot__h">{t('footer.quickLinks')}</h2>
      <ul>
        {navItems.map((item) => (
          <li><a href={localisedPath(item.path, lang)}>{t(item.key)}</a></li>
        ))}
      </ul>
    </nav>

    <div class="foot__col">
      <h2 class="foot__h">{t('footer.contact')}</h2>
      <ul>
        {phones.map((p) => (
          <li>
            {/* dir="ltr" keeps the digits in dialling order inside RTL text */}
            <a href={`tel:${p.tel}`} dir="ltr">{p.label}</a>
          </li>
        ))}
        <li><a href={`mailto:${email}`}>{email}</a></li>
        <li>{address[lang]}</li>
      </ul>
    </div>

    <div class="foot__col">
      <h2 class="foot__h">{t('footer.services')}</h2>
      {/* The pupils' web portal, at the school's own address. */}
      <a class="foot__portal" href={portalUrl}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3 2.5 8 12 13l9.5-5z" />
          <path d="M6 10.5v4.7c0 .6.3 1.1.8 1.4 1.3.8 3.1 1.4 5.2 1.4s3.9-.6 5.2-1.4c.5-.3.8-.8.8-1.4v-4.7" />
        </svg>
        {t('cta.portal')}
      </a>
    </div>

  </div>

  <div class="wrap foot__base">
    <p>&copy; {year} {t('site.name')} &mdash; {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer{
    margin-top:auto;
    background:linear-gradient(180deg,var(--burgundy),var(--burgundy-deep));
    color:rgba(247,241,227,.78);
    padding-top:var(--sp-6);
    border-top:2px solid var(--gold);
  }

  .foot{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:var(--sp-5);
    padding-bottom:var(--sp-5);
  }
  @media (max-width:760px){
    .foot{grid-template-columns:1fr;gap:var(--sp-4);text-align:center}
  }
  .foot__h{
    font-family:var(--font-body);
    font-size:11px;
    font-weight:700;
    letter-spacing:.18em;
    text-transform:uppercase;
    /* gold-light rather than gold: 11px uppercase needs the extra step to
       clear 4.5:1 on the brighter footer ground. */
    color:var(--gold-light);
    margin:0 0 var(--sp-3);
  }
  :root[lang="ar"] .foot__h{letter-spacing:.04em;font-size:13px}

  .foot__col ul{list-style:none;margin:0;padding:0;display:grid;gap:var(--sp-2)}
  .foot__col li{margin:0;max-width:none}
  .foot__col ul a{
    color:rgba(247,241,227,.78);
    text-decoration:none;
    font-size:14px;
    transition:color var(--dur) var(--ease);
  }
  .foot__col ul a:hover{color:var(--gold-pale);text-decoration:underline}

  /* Web portal button. Same object as .portal in the header: glass pill,
     gold hairline, no underline on hover. */
  .foot__portal{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:8px 16px;
    /* Pill, glass, gold hairline - the same object in both bars. */
    border-radius:999px;
    /* No gold outline: the glass alone carries it. */
    border:1px solid transparent;
    background:rgba(247,241,227,.12);
    -webkit-backdrop-filter:blur(10px) saturate(140%);
    backdrop-filter:blur(10px) saturate(140%);
    color:var(--gold-pale);
    text-decoration:none;
    font-size:13px;
    font-weight:600;
    white-space:nowrap;
    transition:background var(--dur) var(--ease),
               border-color var(--dur) var(--ease),
               color var(--dur) var(--ease);
  }
  .foot__portal svg{inline-size:15px;block-size:15px;flex:none;opacity:.85}
  .foot__portal:hover,
  .foot__portal:focus-visible{
    background:rgba(247,241,227,.2);
    color:var(--gold-pale);
    /* No underline: this is a button, not a body link. */
    text-decoration:none;
  }
  @media (max-width:760px){.foot__portal{margin-inline:auto}}

  .foot__base{
    border-top:1px solid rgba(200,162,74,.18);
    padding-block:var(--sp-3);
    text-align:center;
  }
  .foot__base p{
    margin:0;
    max-width:none;
    font-size:12px;
    color:rgba(247,241,227,.45);
    letter-spacing:.04em;
  }
</style>
