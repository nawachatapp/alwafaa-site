---
// A flagged note - used to mark information the school has not yet confirmed.
interface Props { title?: string }
const { title } = Astro.props;
---
<aside class="notice">
  {title && <p class="notice__title">{title}</p>}
  <div class="notice__body"><slot /></div>
</aside>

<style>
  .notice{
    margin-top:var(--sp-5);
    padding:var(--sp-3) var(--sp-4);
    background:var(--surface-alt);
    border:1px solid var(--line);
    border-inline-start:3px solid var(--gold);
    border-radius:var(--radius);
  }
  .notice__title{
    font-weight:700;
    color:var(--burgundy);
    margin:0 0 var(--sp-1);
    font-size:var(--step-0);
  }
  .notice__body{color:var(--ink-soft);font-size:var(--step--1);line-height:1.9}
  .notice__body :global(p){margin:0 0 var(--sp-1)}
  .notice__body :global(p:last-child){margin-bottom:0}
</style>
