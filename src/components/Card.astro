---
interface Props { title: string; meta?: string; href?: string }
const { title, meta, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="card" href={href}>
  {meta && <p class="card__meta">{meta}</p>}
  <h3 class="card__title">{title}</h3>
  <div class="card__body"><slot /></div>
</Tag>

<style>
  .card{
    display:block;
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:var(--sp-4);
    text-decoration:none;
    color:inherit;
    /* The gold rule sits on the inline-start edge, so it flips with direction. */
    border-inline-start:3px solid var(--gold);
    transition:box-shadow var(--dur) var(--ease),transform var(--dur) var(--ease);
  }
  a.card:hover{
    box-shadow:0 10px 28px -14px rgba(74,9,24,.45);
    transform:translateY(-2px);
    border-inline-start-color:var(--burgundy);
  }
  .card__meta{
    font-size:11px;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--gold-ink);
    margin:0 0 var(--sp-1);
    font-weight:600;
  }
  :root[lang="ar"] .card__meta{letter-spacing:.03em;font-size:12px}
  .card__title{font-size:var(--step-1);margin:0 0 var(--sp-2);color:var(--burgundy)}
  .card__body{color:var(--ink-soft);font-size:var(--step-0)}
  .card__body :global(p){margin-bottom:0}
</style>
