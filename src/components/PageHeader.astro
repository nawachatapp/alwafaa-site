---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<header class="page-head">
  <div class="wrap wrap--narrow">
    {eyebrow && <p class="eyebrow page-head__eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <div class="rule rule--start" aria-hidden="true"><b></b><i></i></div>
    {lead && <p class="page-head__lead">{lead}</p>}
  </div>
</header>

<style>
  .page-head{
    background:var(--surface-alt);
    border-bottom:1px solid var(--line);
    padding-block:var(--sp-6) var(--sp-5);
  }
  .page-head__eyebrow{color:var(--gold-ink)}
  .page-head__lead{
    font-size:var(--step-1);
    color:var(--ink-soft);
    line-height:1.7;
    margin:0;
  }
  .rule--start{justify-content:flex-start;max-width:180px;margin-block:var(--sp-3) var(--sp-4)}
</style>
